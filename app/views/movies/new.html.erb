<h1>Add New Movie</h1>

<%= form_for @movie do |f| %>
  <p>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </p>
  <p>
    <%= f.label :rating %><br>
    <%= f.text_field :rating %>
  </p>
  <p>
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </p>
  <p>
    <%= f.label :release_date %><br>
    <%= f.date_select :release_date %>
  </p>
  <p>
    <%= f.submit 'Create Movie' %>
  </p>
<% end %>

<%= link_to 'Back to Movie List', movies_path %>
