<div class="container mt-5">
  <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 600px;">
    <div class="card-body p-4">
      <h2 class="text-center text-primary fw-bold mb-4">Edit Movie</h2>

      <%= form_for(@movie) do |f| %>
        <div class="mb-3">
          <%= f.label :title, class: "form-label fw-semibold" %>
          <%= f.text_field :title, class: "form-control form-control-lg", placeholder: "Enter movie title" %>
        </div>

        <div class="mb-3">
          <%= f.label :rating, class: "form-label fw-semibold" %>
          <%= f.text_field :rating, class: "form-control form-control-lg", placeholder: "Enter rating (e.g., PG-13)" %>
        </div>

        <div class="mb-3">
          <%= f.label :description, class: "form-label fw-semibold" %>
          <%= f.text_area :description, class: "form-control form-control-lg", rows: 4, placeholder: "Write a short description..." %>
        </div>

        <div class="mb-4">
          <%= f.label :release_date, class: "form-label fw-semibold" %>
          <%= f.date_field :release_date, class: "form-control form-control-lg" %>
        </div>

        <div class="d-flex justify-content-center gap-3">
          <%= f.submit "Update Movie", class: "btn btn-success px-4 fw-semibold" %>
          <%= link_to 'Back', movie_path(@movie), class: "btn btn-outline-secondary px-4 fw-semibold" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
